# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Somnus - Boletera

# Database (Postgres propio — no Supabase)
DATABASE_URL=postgresql://somnus_app:password@localhost:5432/somnus
DIRECT_URL=postgresql://somnus_app:password@localhost:5432/somnus

# Auth.js / NextAuth
# Generar: openssl rand -base64 32
AUTH_SECRET=cambia-este-secret-largo-y-aleatorio
JWT_SECRET=cambia-este-secret-largo-y-aleatorio

# OAuth Google (Google Cloud Console → OAuth Client)
# Redirect: https://tu-dominio/api/authjs/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Apple (Apple Developer)
# Redirect: https://tu-dominio/api/authjs/callback/apple
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Clave .p8 con \n escapados, o usa APPLE_SECRET (JWT pregenerado)
APPLE_PRIVATE_KEY=
# APPLE_SECRET=

# Apple Wallet (.pkpass) — certificados en el VPS, nunca en el repo.
# Sin estas variables /api/tickets/:id/pkpass responde 503 y el botón no se muestra.
# Ver docs/IOS_APP_SETUP.md
APPLE_PASS_TYPE_ID=pass.live.somnus.ticket
APPLE_PASS_TEAM_ID=757NQ675N5
APPLE_PASS_CERT_PATH=/etc/somnus/wallet/signerCert.pem
APPLE_PASS_KEY_PATH=/etc/somnus/wallet/signerKey.pem
APPLE_WWDR_CERT_PATH=/etc/somnus/wallet/AppleWWDRCAG4.pem
APPLE_PASS_KEY_PASSPHRASE=
# Alternativa a los PATH: pegar el PEM inline con \n escapados
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_WWDR_CERT_PEM=

# Storage local
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE=/uploads

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENTS_ENABLE_OXXO=false
PAYMENTS_ENABLE_INSTALLMENTS_MX=false
QR_SECRET_KEY=gr-qr-secret-2025-cambiar-en-produccion

# Resend — emails OTP y reset password
RESEND_API_KEY=re_xxxx
# RESEND_FROM=Somnus <noreply@somnus.live>
