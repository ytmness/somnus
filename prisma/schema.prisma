// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// USUARIOS Y AUTENTICACIÓN
// =====================================================

enum UserRole {
  ADMIN       // Control total del sistema
  ORGANIZER   // Organizador de eventos (marketplace)
  VENDEDOR    // Puede vender e imprimir boletos
  SUPERVISOR  // Puede ver reportes y cortes
  ACCESOS     // Solo puede escanear boletos
  CLIENTE     // Cliente que puede ver sus boletos comprados
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  role          UserRole @default(ORGANIZER)
  isActive      Boolean  @default(true)
  
  // Verificación de email (OTP vive en tabla OtpCode)
  emailVerified Boolean  @default(false)

  // Cliente: tour de primer uso en home ya visto
  clientTourSeen Boolean @default(false)

  // Perfil público (estilo Bubbl) — visible en /perfil y cola de aprobaciones
  avatarUrl          String?
  backgroundUrl      String?
  bio                String?  @db.VarChar(500)
  instagramUsername  String?  @db.VarChar(64)
  smsOptIn           Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  sales               Sale[]
  scans               TicketScan[]
  reprints            TicketReprint[]
  auditLogs           AuditLog[]
  organizer           Organizer?
  staffMemberships    StaffMembership[]
  assignedMemberships StaffMembership[] @relation("AssignedBy")
  staffInvitesSent    StaffInvite[]     @relation("InvitedBy")
  organizationFollows OrganizationFollow[]
  organizationPosts   OrganizationPost[]
  sentMessages        Message[]
  conversations       Conversation[]    @relation("ConversationParticipant")
  notifications       Notification[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([role])
  @@index([emailVerified])
}

// =====================================================
// OTP Y RESET DE CONTRASEÑA (reemplazo de Supabase Auth)
// =====================================================

model OtpCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
}

// =====================================================
// ORGANIZADORES (MARKETPLACE)
// =====================================================

enum StripeOnboardingStatus {
  NOT_STARTED
  PENDING
  ACTIVE
  RESTRICTED
}

model Organizer {
  id                     String                 @id @default(uuid())
  userId                 String                 @unique
  businessName           String
  contactEmail           String
  stripeAccountId        String?                @unique
  stripeOnboardingStatus StripeOnboardingStatus @default(NOT_STARTED)
  chargesEnabled         Boolean                @default(false)
  payoutsEnabled         Boolean                @default(false)
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  events          Event[]
  organizations   Organization[]
  commissionRules CommissionRule[]
  venues          Venue[]
  staffMemberships StaffMembership[]

  @@index([stripeAccountId])
  @@index([stripeOnboardingStatus])
}

model Organization {
  id           String   @id @default(uuid())
  organizerId  String
  name         String
  slug         String   @unique
  description  String?
  logoUrl      String?
  bannerUrl    String?
  websiteUrl   String?
  instagramUrl String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizer     Organizer            @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  events        Event[]
  memberships   StaffMembership[]
  followers     OrganizationFollow[]
  posts         OrganizationPost[]
  conversations Conversation[]

  @@index([organizerId])
  @@index([isActive])
  @@index([slug])
}

// =====================================================
// PERFIL SOCIAL DE ORGANIZACIONES
// =====================================================

model OrganizationFollow {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

enum OrgPostType {
  POST
  ANNOUNCEMENT
}

model OrganizationPost {
  id              String      @id @default(uuid())
  organizationId  String
  authorUserId    String
  type            OrgPostType @default(POST)
  content         String
  imageUrl        String?
  notifyFollowers Boolean     @default(false)
  isPublished     Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([authorUserId])
}

model Conversation {
  id                String    @id @default(uuid())
  organizationId    String
  participantUserId String
  lastMessageAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant  User         @relation("ConversationParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([organizationId, participantUserId])
  @@index([participantUserId])
  @@index([organizationId, lastMessageAt])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_MESSAGE
  NEW_POST
  ORG_ANNOUNCEMENT
  NEW_EVENT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// =====================================================
// VENUES (RECINTOS REUTILIZABLES)
// =====================================================

model Venue {
  id          String   @id @default(uuid())
  organizerId String
  name        String
  address     String?
  city        String?
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer   Organizer         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  events      Event[]
  memberships StaffMembership[]

  @@index([organizerId])
  @@index([isActive])
  @@index([organizerId, name])
}

// =====================================================
// STAFF Y MEMBRESÍAS CON ALCANCE
// =====================================================

enum StaffRole {
  VENDEDOR
  SUPERVISOR
  ACCESOS
  VENUE_MANAGER
  MESA_HOST
}

enum MembershipScope {
  PLATFORM
  ORGANIZER
  ORGANIZATION
  VENUE
  EVENT
  TABLE
}

model StaffMembership {
  id             String          @id @default(uuid())
  userId         String
  role           StaffRole
  scope          MembershipScope
  organizerId    String?
  organizationId String?
  venueId        String?
  eventId        String?
  tableNumber    String?
  assignedById   String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?         @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  organizer    Organizer?    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue        Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scope, organizerId, organizationId, venueId, eventId, tableNumber])
  @@index([userId])
  @@index([role])
  @@index([scope])
  @@index([eventId])
  @@index([venueId])
  @@index([organizerId])
  @@index([isActive])
}

model StaffInvite {
  id             String          @id @default(uuid())
  email          String
  role           StaffRole
  scope          MembershipScope
  organizerId    String?
  organizationId String?
  venueId        String?
  eventId        String?
  tableNumber    String?
  token          String          @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime        @default(now())

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

// =====================================================
// COMISIONES DE PLATAFORMA
// =====================================================

enum CommissionScope {
  GLOBAL
  ORGANIZER
  EVENT
}

enum CommissionType {
  PERCENTAGE
  FIXED
  PERCENTAGE_PLUS_FIXED
}

model CommissionRule {
  id                    String          @id @default(uuid())
  scope                 CommissionScope
  organizerId           String?
  eventId               String?         @unique
  commissionType        CommissionType
  commissionPercentage  Decimal?        @db.Decimal(5, 2)
  commissionFixedAmount Decimal?        @db.Decimal(10, 2)
  currency              String          @default("MXN")
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organizer Organizer? @relation(fields: [organizerId], references: [id])
  event     Event?     @relation(fields: [eventId], references: [id])

  @@index([scope])
  @@index([organizerId])
  @@index([isActive])
}

// =====================================================
// EVENTOS
// =====================================================

model Event {
  id                String   @id @default(uuid())
  name              String
  description       String?
  artist            String
  tour              String?
  venue             String
  address           String?
  eventDate         DateTime
  eventTime         String
  imageUrl          String?
  /// Focal point X for poster crop (0–100, CSS object-position %)
  imagePosX         Float    @default(50)
  /// Focal point Y for poster crop (0–100, CSS object-position %)
  imagePosY         Float    @default(50)
  /// Poster zoom scale (1 = fit cover, up to ~2.5)
  imageZoom         Float    @default(1)
  maxCapacity       Int      // Aforo máximo autorizado (ej: 5000)
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false) // Destacado en hero (solo ADMIN)
  showQR            Boolean  @default(true) // Mostrar QR en mis-boletos (control desde admin)
  salesStartDate    DateTime
  salesEndDate      DateTime
  organizerId       String?  // null = evento de plataforma
  organizationId    String?  // marca/organización bajo la que se publica
  venueId           String?  // FK a Venue reutilizable
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  organizer         Organizer?        @relation(fields: [organizerId], references: [id])
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  venueRef          Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  ticketTypes       TicketType[]
  sales             Sale[]
  tableSlotInvites  TableSlotInvite[]
  tableInvitePools  TableInvitePool[]
  commissionRule    CommissionRule?
  staffMemberships  StaffMembership[]

  @@index([eventDate])
  @@index([isActive])
  @@index([isFeatured])
  @@index([organizerId])
  @@index([organizationId])
  @@index([venueId])
}

// =====================================================
// TIPOS DE BOLETO (GENERAL, PREFERENTE, VIP)
// =====================================================

enum TicketCategory {
  GENERAL
  PREFERENTE
  VIP
}

/// STANDARD = entrada normal; TABLE = mesa simple (nuevo flujo, independiente de isTable legado)
enum TicketKind {
  STANDARD
  TABLE
}

model TicketType {
  id            String         @id @default(uuid())
  eventId       String
  name          String         // ej: "General A", "VIP Mesa 4 personas"
  description   String?
  category      TicketCategory
  price         Decimal        @db.Decimal(10, 2)
  maxQuantity   Int            // Cupo máximo para este tipo
  soldQuantity  Int            @default(0) // Cantidad vendida
  isActive      Boolean        @default(true)
  
  // Para VIP - si es mesa de 4 personas (legado mapa/invites)
  isTable       Boolean        @default(false)
  seatsPerTable Int?           // ej: 4 para mesas VIP

  // Nuevo flujo entrada/mesa
  kind                   TicketKind @default(STANDARD)
  isHidden               Boolean    @default(false)
  manualSoldOut          Boolean    @default(false)
  salesStartDate         DateTime?
  salesEndDate           DateTime?
  validUntil             DateTime?
  minPurchaseQty         Int        @default(1)
  maxPurchaseQty         Int?
  requiresApproval       Boolean    @default(false)
  passwordHash           String?
  linkedTicketTypeId     String?
  tableCapacity          Int?
  depositEnabled         Boolean    @default(false)
  depositPercent         Int?
  variablePricingEnabled Boolean    @default(false)
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relaciones
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets          Ticket[]
  tableSlotInvites TableSlotInvite[]
  tableInvitePools TableInvitePool[] @relation("PoolTableTicket")
  coverInvitePools TableInvitePool[] @relation("PoolCoverTicket")
  pricePhases      TicketPricePhase[]
  groupPriceRows   TableGroupPriceRow[]
  linkedTicketType TicketType?      @relation("LinkedTicket", fields: [linkedTicketTypeId], references: [id], onDelete: SetNull)
  linkedFrom       TicketType[]     @relation("LinkedTicket")

  @@index([eventId])
  @@index([category])
  @@index([isActive])
  @@index([kind])
  @@index([linkedTicketTypeId])
}

/// Precios variables por tamaño de grupo (solo kind=TABLE)
model TableGroupPriceRow {
  id           String   @id @default(uuid())
  ticketTypeId String
  minGuests    Int
  maxGuests    Int
  price        Decimal  @db.Decimal(10, 2)
  sortOrder    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([ticketTypeId])
}

/// Precio vigente por ventana de fechas (preventa, regular, etc.). Si no hay fase activa, aplica `TicketType.price`.
model TicketPricePhase {
  id           String   @id @default(uuid())
  ticketTypeId String
  price        Decimal  @db.Decimal(10, 2)
  startsAt     DateTime
  endsAt       DateTime
  label        String?  // ej. "Preventa", "Fase 1"
  sortOrder    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([ticketTypeId])
  @@index([ticketTypeId, startsAt, endsAt])
}

// =====================================================
// VENTAS (TRANSACCIONES)
// =====================================================

enum SaleChannel {
  ONLINE  // Venta web
  POS     // Punto de venta físico
}

enum SaleStatus {
  PENDING    // Pendiente de pago
  COMPLETED  // Pagada y confirmada
  CANCELLED  // Cancelada
  REFUNDED   // Reembolsada
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Sale {
  id                  String      @id @default(uuid())
  eventId             String
  userId              String?     // Vendedor (null si es online sin vendedor asignado)
  channel             SaleChannel
  status              SaleStatus  @default(PENDING)
  
  subtotal            Decimal     @db.Decimal(10, 2)
  tax                 Decimal     @db.Decimal(10, 2) // IVA
  total               Decimal     @db.Decimal(10, 2)
  
  // Info del comprador
  buyerName           String
  buyerEmail          String
  buyerPhone          String?

  // Email de recibo con QR (anti-doble envío)
  emailReceiptStatus String   @default("NOT_SENT") // NOT_SENT | SENDING | SENT | FAILED
  emailReceiptSentAt DateTime?
  emailReceiptError  String?
  
  // Venta desde invite de mesa (trazabilidad)
  tableSlotInviteId   String?     @unique
  
  // Pago
  paymentMethod       String?     // "efectivo", "tarjeta", "stripe", "clip", etc
  paymentId           String?     // ID de pago externo
  paymentProvider     String?     // "clip" | "stripe"
  providerStatus      String?     // requires_payment_method, succeeded, canceled, refunded
  paymentIntentId     String?     @unique
  checkoutSessionId   String?     @unique
  stripeChargeId      String?
  stripeConnectedAccountId String?
  stripeCustomerId    String?
  platformFeeAmount   Decimal?    @db.Decimal(10, 2)
  organizerNetAmount  Decimal?    @db.Decimal(10, 2)
  lastWebhookEventId  String?
  paidAt              DateTime?

  // Aprobación (requiresApproval en ticket types)
  approvalStatus       ApprovalStatus @default(NOT_REQUIRED)
  approvedAt           DateTime?
  approvedByUserId     String?

  // Depósito parcial
  depositOnly          Boolean   @default(false)
  balanceDueCents      Int?
  balancePaidAt        DateTime?
  balancePayToken      String?   @unique
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relaciones
  event             Event             @relation(fields: [eventId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])
  saleItems         SaleItem[]
  tickets           Ticket[]
  tableSlotInvite   TableSlotInvite? @relation(fields: [tableSlotInviteId], references: [id])

  @@index([eventId])
  @@index([status])
  @@index([createdAt])
  @@index([buyerEmail])
  @@index([paymentProvider])
  @@index([paymentIntentId])
  @@index([providerStatus])
  @@index([approvalStatus])
  @@index([balancePayToken])
}

// Líneas de la venta (antes de pagar, para recrear tickets)
model SaleItem {
  id            String   @id @default(uuid())
  saleId        String
  ticketTypeId  String
  quantity      Int
  isTable       Boolean  @default(false)
  tableNumber   String?
  guestCount    Int?     // tamaño de grupo (precio variable en mesas nuevas)

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// =====================================================
// BOLETOS INDIVIDUALES
// =====================================================

enum TicketStatus {
  VALID     // Válido, no usado
  USED      // Ya se usó (escaneado en acceso)
  CANCELLED // Cancelado
  REPRINTED // Fue reimpreso
}

model Ticket {
  id              String        @id @default(uuid())
  saleId          String
  ticketTypeId    String
  
  // Identificación única
  ticketNumber    String        @unique // Folio único incremental
  qrCode          String        @unique // Hash único para QR
  
  status          TicketStatus  @default(VALID)
  
  // Para mesas VIP - identificar asiento dentro de la mesa
  tableNumber     String?       // ej: "Mesa 5"
  seatNumber      Int?          // ej: 1, 2, 3, 4 (para mesa de 4)
  
  // PDF generado
  pdfUrl          String?       // URL del PDF en storage
  
  // Control de acceso
  scannedAt       DateTime?
  scannedBy       String?       // userId que escaneó
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relaciones
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticketType      TicketType    @relation(fields: [ticketTypeId], references: [id])
  scans           TicketScan[]
  reprints        TicketReprint[]

  @@index([qrCode])
  @@index([ticketNumber])
  @@index([status])
  @@index([saleId])
}

// =====================================================
// INVITES DE MESAS VIP (URL PERSONALIZADO POR ASIENTO)
// =====================================================

enum SlotInviteStatus {
  PENDING    // Link creado, pendiente de pago
  PAID       // Pagado exitosamente
  EXPIRED    // Venció sin pagar
  CANCELLED  // Cancelado por anfitrión
}

// Pool tipo "money pool": un solo link para toda la mesa, cada quien paga y se registra
model TableInvitePool {
  id            String   @id @default(uuid())
  eventId       String
  ticketTypeId  String
  /// Boleto de entrada (cover) para extras una vez confirmada la mesa / monto
  coverTicketTypeId String?
  tableNumber   String   // Nombre o número de mesa (ej: "42", "Terraza A")
  inviteToken   String   @unique // Un solo token para toda la mesa
  maxSlots      Int?     // Tope de pagos en el link; null = sin límite
  splitAmong    Int      // Entre cuántas personas se divide el precio total (ej: 34)
  minPaidToConfirm Int @default(20) // Pagos necesarios para considerar la mesa "confirmada"
  pricePerSeat  Decimal  @db.Decimal(10, 2)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType       TicketType  @relation("PoolTableTicket", fields: [ticketTypeId], references: [id], onDelete: Cascade)
  coverTicketType  TicketType? @relation("PoolCoverTicket", fields: [coverTicketTypeId], references: [id], onDelete: SetNull)
  slotInvites      TableSlotInvite[] // Slots creados al pagar (invitedName/email/phone al momento del pago)

  @@index([eventId])
  @@index([inviteToken])
  @@index([eventId, tableNumber])
  @@index([coverTicketTypeId])
}

model TableSlotInvite {
  id            String           @id @default(uuid())
  eventId       String
  ticketTypeId  String           // TicketType VIP de mesas
  tableNumber   String           // Nombre o número de mesa (ej: "42", "Terraza A")
  seatNumber    Int              // 1, 2, 3... hasta seatsPerTable
  poolId        String?          // Si viene de TableInvitePool (money pool)
  
  // Token único para la URL (8 chars) - en modo pool se genera al crear el slot al pagar
  inviteToken  String           @unique
  
  // Info del invitado (quien va a pagar)
  invitedName  String           // "Juan Pérez"
  invitedEmail String?
  invitedPhone String?
  
  // Estado
  status       SlotInviteStatus @default(PENDING)
  
  // Cuándo pagó (para timeline)
  paidAt       DateTime?
  
  // Precio por asiento (precio mesa / seatsPerTable)
  pricePerSeat Decimal         @db.Decimal(10, 2)

  /// true = pago cover (extra tras mesa confirmada); false = cupo de mesa
  isCover      Boolean         @default(false)
  
  expiresAt    DateTime?       // Vence en X días si no paga (default: createdAt + 7)
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  pool         TableInvitePool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  sale         Sale?           // Back-relation: Sale que pagó este invite (Sale.tableSlotInviteId)

  @@index([eventId])
  @@index([inviteToken])
  @@index([eventId, tableNumber])
  @@index([poolId])
}

// =====================================================
// ESCANEOS DE BOLETOS (ACCESOS)
// =====================================================

enum ScanResult {
  SUCCESS          // Escaneo exitoso
  ALREADY_USED     // Ya fue usado
  INVALID          // QR inválido
  CANCELLED        // Boleto cancelado
  EVENT_MISMATCH   // No corresponde a este evento
}

model TicketScan {
  id          String     @id @default(uuid())
  ticketId    String
  scannedBy   String     // userId del staff de accesos
  result      ScanResult
  notes       String?    // Notas adicionales
  scannedAt   DateTime   @default(now())
  
  // Metadata
  deviceInfo  String?    // Info del dispositivo que escaneó
  location    String?    // Carril de acceso

  // Relaciones
  ticket      Ticket     @relation(fields: [ticketId], references: [id])
  user        User       @relation(fields: [scannedBy], references: [id])

  @@index([ticketId])
  @@index([scannedAt])
  @@index([result])
}

// =====================================================
// REIMPRESIONES (CONTROL DE AUDITORÍA)
// =====================================================

model TicketReprint {
  id            String   @id @default(uuid())
  ticketId      String
  authorizedBy  String   // userId del Admin que autorizó
  reason        String   // Motivo de la reimpresión
  reprintedAt   DateTime @default(now())

  // Relaciones
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
  user          User     @relation(fields: [authorizedBy], references: [id])

  @@index([ticketId])
  @@index([reprintedAt])
}

// =====================================================
// REGISTRO DE AUDITORÍA (LOGS DEL SISTEMA)
// =====================================================

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  SALE_CREATED
  SALE_COMPLETED
  SALE_CANCELLED
  TICKET_GENERATED
  TICKET_SCANNED
  TICKET_REPRINTED
  INVENTORY_UPDATED
  PRICE_CHANGED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_DELETED
  SQL_EXECUTED
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  entityType  String      // "Sale", "Ticket", "Event", etc
  entityId    String      // ID de la entidad afectada
  changes     Json?       // Objeto JSON con los cambios realizados
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  // Relaciones
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// =====================================================
// GALERÍA (secciones y fotos gestionadas desde admin)
// =====================================================

model GallerySection {
  id        String   @id @default(uuid())
  title     String   // ej: "Panorama", "Somnus 1"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    GalleryImage[]
}

model GalleryImage {
  id         String   @id @default(uuid())
  sectionId  String
  url        String   // /assets/... o URL externa
  sortOrder  Int      @default(0)
  alt        String?
  createdAt  DateTime @default(now())

  section    GallerySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// =====================================================
// CONTACTO / LEADS (formulario de la home)
// =====================================================

model ContactLead {
  id        String   @id @default(uuid())
  name      String
  lastName  String
  email     String
  phone     String?
  country   String?
  city      String?
  agreedToTerms Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// =====================================================
// CONFIGURACIÓN DEL SISTEMA
// =====================================================

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique // "tax_rate", "max_tickets_per_sale", etc
  value       String   // Valor de la configuración
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// =====================================================
// WEBHOOKS DE PAGO (AUDITORÍA E IDEMPOTENCIA)
// =====================================================

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String    // "stripe" | "clip"
  providerEventId String    @unique
  type            String
  saleId          String?
  livemode        Boolean   @default(false)
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, type])
  @@index([saleId])
}
