// =====================================================
// CAMPAIGN BLASTS (SMS / PUSH)
// =====================================================

enum BlastChannel {
  SMS
  PUSH
  EMAIL
}

enum BlastStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model CampaignBlast {
  id            String       @id @default(uuid())
  eventId       String?
  channel       BlastChannel
  subject       String?
  body          String
  status        BlastStatus  @default(DRAFT)
  recipientCount Int         @default(0)
  sentCount     Int          @default(0)
  clickCount    Int          @default(0)
  salesCount    Int          @default(0)
  salesAmount   Decimal      @default(0) @db.Decimal(12, 2)
  trackingCode  String       @unique @default(uuid())
  sentAt        DateTime?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sales Sale[]

  @@index([eventId])
  @@index([trackingCode])
  @@index([status])
}

// =====================================================
// PROMOTER TRACKING LINKS
// =====================================================

model PromoterLink {
  id            String   @id @default(uuid())
  eventId       String
  userId        String   // promoter user
  code          String
  label         String?
  clickCount    Int      @default(0)
  salesCount    Int      @default(0)
  salesAmount   Decimal  @default(0) @db.Decimal(12, 2)
  commissionPct Decimal? @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@unique([eventId, code])
  @@index([userId])
  @@index([code])
}

// =====================================================
// REFERRAL PROGRAM
// =====================================================

model ReferralCode {
  id              String   @id @default(uuid())
  userId          String   @unique
  code            String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals ReferralAttribution[]

  @@index([code])
}

model ReferralAttribution {
  id               String   @id @default(uuid())
  referralCodeId   String
  referredOrganizerId String
  startsAt         DateTime @default(now())
  endsAt           DateTime // startsAt + 12 months
  revenueSharePct  Decimal  @default(15) @db.Decimal(5, 2)
  totalEarned      Decimal  @default(0) @db.Decimal(12, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@unique([referredOrganizerId])
  @@index([referralCodeId])
}

// =====================================================
// CONTACT IMPORT
// =====================================================

model ContactImport {
  id          String   @id @default(uuid())
  userId      String
  fileName    String?
  totalRows   Int      @default(0)
  importedRows Int     @default(0)
  failedRows  Int      @default(0)
  status      String   @default("PENDING") // PENDING | DONE | FAILED
  createdAt   DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts ImportedContact[]

  @@index([userId])
}

model ImportedContact {
  id         String   @id @default(uuid())
  importId   String
  email      String?
  phone      String?
  name       String?
  tags       String?
  createdAt  DateTime @default(now())

  import ContactImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([email])
}

// =====================================================
// MEMBERSHIPS (SUSCRIPCIÓN DE COMUNIDAD)
// =====================================================

model MembershipPlan {
  id                   String   @id @default(uuid())
  organizationId       String
  name                 String
  description          String?
  priceCents           Int
  currency             String   @default("MXN")
  interval             String   @default("month") // month | year
  stripePriceId        String?
  stripeProductId      String?
  perks                String?  // JSON or free text
  earlyAccessHours     Int?     // hours before public sale
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrgMembership[]

  @@index([organizationId])
}

enum MembershipStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model OrgMembership {
  id                   String           @id @default(uuid())
  userId               String
  organizationId       String
  planId               String
  status               MembershipStatus @default(ACTIVE)
  stripeSubscriptionId String?          @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([status])
}
